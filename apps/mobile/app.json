{
  "expo": {
    "name": "Voyago",
    "slug": "voyago",
    "scheme": "voyago",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voyago.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.voyago.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Voyago uses your photos only when you choose a trip cover, community cover or post photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Voyago uses your location only when you tap Near me, to show trips meeting near you. It is not stored."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
