# Base URL of the Voyago API. On a physical device use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Google sign-in (optional). OAuth client ids from Google Cloud Console, one per platform.
# Put the same ids in the API's GOOGLE_CLIENT_IDS (comma separated) so it accepts their tokens.
# Leave empty to hide the Google button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Apple sign-in needs no app key: it works on iOS builds once the API's APPLE_CLIENT_IDS
# contains the bundle id (com.voyago.app).

# Push notifications (optional). The Expo project id from `eas init`; push tokens need it.
# FCM (Android): put google-services.json from Firebase somewhere outside git and set its path.
# APNs (iOS): upload your APNs key with `eas credentials`. Then set PUSH_PROVIDER=expo on the API.
EAS_PROJECT_ID=
GOOGLE_SERVICES_FILE=
