# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (admin app, Expo web).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
LOG_LEVEL=debug
# API reference at /api/docs. Empty = on except in production; true or false to force it.
API_DOCS_ENABLED=

# Must match infra/docker/.env when using the local Docker services.
DATABASE_URL=postgresql://voyago:change-me@localhost:5432/voyago?schema=public
# Session settings per connection (default turns JIT off). Empty if your pooler rejects them.
DATABASE_SESSION_OPTIONS=-c jit=off
REDIS_URL=redis://localhost:6379

# true behind a load balancer / reverse proxy (so rate limits use the real client IP).
TRUST_PROXY=false

# Global rate limit per client IP.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# ── Authentication ───────────────────────────────────────────────────────────
# Generate each secret with: openssl rand -base64 48   (they must differ)
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-0123456789
OTP_HMAC_SECRET=dev-only-change-me-otp-secret-9876543210abc
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# none | dev | twilio | msg91. "dev" logs OTP codes locally and is refused in production.
SMS_PROVIDER=dev
# Twilio (SMS_PROVIDER=twilio): set TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# MSG91 (SMS_PROVIDER=msg91): DLT-approved OTP flow template; MSG91_OTP_VARIABLE names its code variable.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VARIABLE=otp
# Optional: DLT-approved SOS template with variables name, trip and link, so SOS can text
# emergency contacts through MSG91. (Twilio sends SOS texts with no extra setup.)
MSG91_SOS_TEMPLATE_ID=

# none | dev | resend | postmark. "dev" logs emails locally and is refused in production.
EMAIL_PROVIDER=dev
# Sender on a domain verified with your provider, e.g. Voyago <no-reply@yourdomain.in>
EMAIL_FROM=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
APP_PUBLIC_URL=http://localhost:8081
# Comma-separated OAuth client ids. Leave empty to disable Google / Apple sign-in.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Requests per minute per IP on each sign-in / OTP / recovery route.
AUTH_RATE_LIMIT_MAX=10

# ── Maps and media (optional) ────────────────────────────────────────────────
# Google Maps Platform key with "Places API (New)" and "Routes API" enabled. Server-side only.
GOOGLE_MAPS_API_KEY=
# Cloudinary (trip and community covers, post photos). All three or none. The secret stays on the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=voyago-dev

# ── Discovery (milestone 06) ──────────────────────────────────────────────────
# Radius for nearby search when the app does not send one, and the largest allowed.
DISCOVERY_DEFAULT_RADIUS_KM=25
DISCOVERY_MAX_RADIUS_KM=200

# ── Chat and push notifications ──────────────────────────────────────────────
# Messages a member may send per minute.
CHAT_RATE_LIMIT_PER_MINUTE=30
# none = in-app notifications only; dev = log pushes (not in production);
# expo = Expo push service. Expo delivers through FCM (Android) and APNs (iOS): upload those
# credentials to your Expo project with `eas credentials`, and set EAS_PROJECT_ID in the app's .env.
PUSH_PROVIDER=none
# Only if "enhanced push security" is on in the Expo project (expo.dev > Access tokens).
EXPO_ACCESS_TOKEN=

# ── Payments (milestone 13) ──────────────────────────────────────────────────
# none = booking stays closed. razorpay = Razorpay (Orders, Checkout, webhooks, refunds).
# Use TEST keys (rzp_test_...) from Dashboard > Account & Settings > API keys. Live keys
# (rzp_live_...) are refused unless PAYMENTS_LIVE_APPROVED=true, which must wait for the legal
# review, provider approval and operator agreements.
PAYMENT_PROVIDER=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL <API_PUBLIC_URL>/api/v1/webhooks/razorpay, events payment.authorized,
# payment.captured, payment.failed, order.paid, refund.processed, refund.failed, and for
# subscriptions subscription.activated, subscription.charged, subscription.pending,
# subscription.halted, subscription.cancelled, subscription.completed. Put its secret here.
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_LIVE_APPROVED=false
# Commission in basis points (1000 = 10%) and the tax on it (1800 = 18% GST), for new bookings.
PLATFORM_COMMISSION_BPS=1000
COMMISSION_TAX_BPS=1800
# Public address of this API (the payment page returns here). Must be https in production.
API_PUBLIC_URL=http://localhost:3000

# ── Subscriptions (milestone 14) ─────────────────────────────────────────────
# Explorer Pro and Organiser Pro use the same Razorpay keys (Subscriptions must be enabled on the
# Razorpay account). false hides paid plans; existing subscriptions keep working. Prices are
# edited per plan in the admin app and apply to new subscriptions only.
SUBSCRIPTIONS_ENABLED=true

# ── Analytics and operations (milestone 15) ─────────────────────────────────
# All optional. Analytics events are first-party and pseudonymous; see docs/ANALYTICS.md.
# ANALYTICS_HASH_KEY: 32+ characters (openssl rand -base64 48); empty derives it from OTP_HMAC_SECRET.
ANALYTICS_HASH_KEY=
ANALYTICS_RETENTION_DAYS=400
# Bearer token for Prometheus to scrape GET /metrics; empty turns the endpoint off (404).
METRICS_TOKEN=
# Slack-compatible incoming webhook (https) for alerts; empty logs alerts only.
ALERT_WEBHOOK_URL=
