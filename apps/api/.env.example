# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (admin app, Expo web).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
LOG_LEVEL=debug

# Must match infra/docker/.env when using the local Docker services.
DATABASE_URL=postgresql://voyago:change-me@localhost:5432/voyago?schema=public
REDIS_URL=redis://localhost:6379

# true behind a load balancer / reverse proxy (so rate limits use the real client IP).
TRUST_PROXY=false

# Global rate limit per client IP.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# ── Authentication ───────────────────────────────────────────────────────────
# Generate each secret with: openssl rand -base64 48   (they must differ)
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-0123456789
OTP_HMAC_SECRET=dev-only-change-me-otp-secret-9876543210abc
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# none | dev. "dev" logs OTP codes and emails locally and is refused when NODE_ENV=production.
SMS_PROVIDER=dev
EMAIL_PROVIDER=dev
APP_PUBLIC_URL=http://localhost:8081
# Comma-separated OAuth client ids. Leave empty to disable Google / Apple sign-in.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Requests per minute per IP on each sign-in / OTP / recovery route.
AUTH_RATE_LIMIT_MAX=10

# ── Maps and media (optional) ────────────────────────────────────────────────
# Google Maps Platform key with "Places API (New)" and "Routes API" enabled. Server-side only.
GOOGLE_MAPS_API_KEY=
# Cloudinary (cover images). All three or none. The secret stays on the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=voyago-dev
