# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (admin app, Expo web).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
LOG_LEVEL=debug

# Must match infra/docker/.env when using the local Docker services.
DATABASE_URL=postgresql://voyago:change-me@localhost:5432/voyago?schema=public
REDIS_URL=redis://localhost:6379

# true behind a load balancer / reverse proxy (so rate limits use the real client IP).
TRUST_PROXY=false

# Global rate limit per client IP.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# ── Authentication ───────────────────────────────────────────────────────────
# Generate each secret with: openssl rand -base64 48   (they must differ)
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-0123456789
OTP_HMAC_SECRET=dev-only-change-me-otp-secret-9876543210abc
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# none | dev | twilio | msg91. "dev" logs OTP codes locally and is refused in production.
SMS_PROVIDER=dev
# Twilio (SMS_PROVIDER=twilio): set TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# MSG91 (SMS_PROVIDER=msg91): DLT-approved OTP flow template; MSG91_OTP_VARIABLE names its code variable.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VARIABLE=otp

# none | dev | resend | postmark. "dev" logs emails locally and is refused in production.
EMAIL_PROVIDER=dev
# Sender on a domain verified with your provider, e.g. Voyago <no-reply@yourdomain.in>
EMAIL_FROM=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
APP_PUBLIC_URL=http://localhost:8081
# Comma-separated OAuth client ids. Leave empty to disable Google / Apple sign-in.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Requests per minute per IP on each sign-in / OTP / recovery route.
AUTH_RATE_LIMIT_MAX=10

# ── Maps and media (optional) ────────────────────────────────────────────────
# Google Maps Platform key with "Places API (New)" and "Routes API" enabled. Server-side only.
GOOGLE_MAPS_API_KEY=
# Cloudinary (trip and community covers, post photos). All three or none. The secret stays on the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=voyago-dev

# ── Discovery (milestone 06) ──────────────────────────────────────────────────
# Radius for nearby search when the app does not send one, and the largest allowed.
DISCOVERY_DEFAULT_RADIUS_KM=25
DISCOVERY_MAX_RADIUS_KM=200
