// ─────────────────────────────────────────────────────────────────────────────
// Users and profiles
// ─────────────────────────────────────────────────────────────────────────────

/// A registered member. Contact details (email, phone) are private and never public.
model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Case-insensitive unique handle.
  username           String     @unique @db.Citext
  /// Case-insensitive unique; private.
  email              String?    @unique @db.Citext
  /// E.164 format; private.
  phone              String?    @unique @db.VarChar(16)
  /// Argon2/bcrypt hash set in milestone 04. Never the password itself.
  passwordHash       String?    @map("password_hash")
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt    DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  displayName        String     @map("display_name") @db.VarChar(80)
  bio                String?    @db.VarChar(500)
  /// Object-storage key, not a URL.
  avatarKey          String?    @map("avatar_key")
  /// Public, city-level only. Exact home location is never stored.
  homeCity           String?    @map("home_city") @db.VarChar(80)
  /// ISO 3166-1 alpha-2 country code.
  country            String     @default("IN") @db.Char(2)
  /// ISO 639-1 language codes, e.g. ["en", "kn", "hi"].
  languages          String[]   @default([])
  role               UserRole   @default(USER)
  status             UserStatus @default(ACTIVE)
  lastActiveAt       DateTime?  @map("last_active_at") @db.Timestamptz(3)
  /// First time the profile was filled in (bio, home city, a language, an interest).
  profileCompletedAt DateTime?  @map("profile_completed_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Soft delete; personal fields are scrubbed by the account-deletion job.
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(3)
  /// Profile accent colour (a paid feature; hidden while the plan is not active).
  accentColor        String?    @map("accent_color") @db.VarChar(20)
  /// Organiser headline (Organiser Pro; hidden while the plan is not active).
  profileHeadline    String?    @map("profile_headline") @db.VarChar(120)

  preferences         UserPreference?
  motorcycles         Motorcycle[]
  organisedTrips      Trip[]               @relation("TripOrganiser")
  participations      TripParticipant[]    @relation("Participant")
  removedParticipants TripParticipant[]    @relation("ParticipantRemover")
  joinRequests        TripJoinRequest[]    @relation("JoinRequester")
  decidedJoinRequests TripJoinRequest[]    @relation("JoinRequestDecider")
  createdCommunities  Community[]          @relation("CommunityCreator")
  communityMembership CommunityMember[]
  following           Follow[]             @relation("Follower")
  followers           Follow[]             @relation("Followee")
  blocking            UserBlock[]          @relation("Blocker")
  blockedBy           UserBlock[]          @relation("Blocked")
  conversationMembers ConversationMember[]
  sentMessages        Message[]
  notifications       Notification[]
  pushTokens          PushToken[]
  reviewsWritten      Review[]             @relation("Reviewer")
  reviewsReceived     Review[]             @relation("Reviewee")
  tripInvitations     TripInvitation[]     @relation("TripInvitee")
  sentTripInvitations TripInvitation[]     @relation("TripInviter")
  posts               Post[]               @relation("PostAuthor")
  reportsFiled        Report[]             @relation("Reporter")
  reportsAgainst      Report[]             @relation("ReportedUser")
  reportsAssigned     Report[]             @relation("ReportAssignee")
  operator            CommercialOperator?  @relation("OperatorOwner")
  verifiedOperators   CommercialOperator[] @relation("OperatorVerifier")
  reviewedDocuments   OperatorDocument[]   @relation("DocumentReviewer")
  hiddenTrips         Trip[]               @relation("TripHider")
  bookings            Booking[]
  payments            Payment[]
  subscriptions       Subscription[]
  savedSearches       SavedSearch[]
  locationSessions    LocationSession[]
  emergencyContacts   EmergencyContact[]
  tripCheckIns        TripCheckIn[]
  sosAlerts           SosAlert[]           @relation("SosRaiser")
  resolvedSosAlerts   SosAlert[]           @relation("SosResolver")
  packageQuestions    PackageQuestion[]    @relation("PackageQuestionAsker")
  answeredQuestions   PackageQuestion[]    @relation("PackageQuestionAnswerer")
  refundsRequested    Refund[]             @relation("RefundRequester")
  auditLogs           AuditLog[]
  sessions            AuthSession[]
  identities          AuthIdentity[]
  verificationTokens  VerificationToken[]

  @@index([status])
  @@index([homeCity])
  @@map("users")
}

model UserPreference {
  userId                String            @id @map("user_id") @db.Uuid
  preferredMode         TripMode?         @map("preferred_mode")
  /// Free-form interest tags, e.g. "photography", "camping".
  interests             String[]          @default([])
  preferredActivities   ActivityType[]    @default([]) @map("preferred_activities")
  travelStyles          TravelStyle[]     @default([]) @map("travel_styles")
  /// Free-text destination names, e.g. "Coorg", "Gokarna".
  preferredDestinations String[]          @default([]) @map("preferred_destinations")
  budgetMinPaise        Int?              @map("budget_min_paise")
  budgetMaxPaise        Int?              @map("budget_max_paise")
  groupSizeMin          Int?              @map("group_size_min") @db.SmallInt
  groupSizeMax          Int?              @map("group_size_max") @db.SmallInt
  ridingExperience      RidingExperience? @map("riding_experience")
  profileVisibility     ProfileVisibility @default(PUBLIC) @map("profile_visibility")
  allowMessagesFrom     MessagePermission @default(TRIP_PARTICIPANTS) @map("allow_messages_from")
  pushEnabled           Boolean           @default(true) @map("push_enabled")
  emailEnabled          Boolean           @default(true) @map("email_enabled")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// Safety: a block hides each user from the other. Always free.
model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Motorcycle {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId            String                    @map("owner_id") @db.Uuid
  make               String                    @db.VarChar(60)
  model              String                    @db.VarChar(80)
  year               Int?                      @db.SmallInt
  engineCc           Int?                      @map("engine_cc") @db.SmallInt
  category           MotorcycleCategory
  nickname           String?                   @db.VarChar(60)
  photoKey           String?                   @map("photo_key")
  isPrimary          Boolean                   @default(false) @map("is_primary")
  /// Set by moderators after document review (later milestone). Documents and
  /// registration numbers are never stored in this table or exposed publicly.
  verificationStatus VehicleVerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("motorcycles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Authentication
// ─────────────────────────────────────────────────────────────────────────────

/// One signed-in device. The refresh token itself is never stored, only its SHA-256 hash.
/// Refreshing rotates the token: the old session row is revoked and points at its replacement.
/// Presenting a revoked token again revokes the whole family (token theft detection).
model AuthSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// All sessions descending from one sign-in share a family id.
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?   @map("revoked_reason") @db.VarChar(40)
  replacedById     String?   @unique @map("replaced_by_id") @db.Uuid
  userAgent        String?   @map("user_agent") @db.VarChar(200)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy AuthSession? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   AuthSession? @relation("SessionRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// A Google or Apple account linked to a user.
model AuthIdentity {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  /// The provider's stable subject id (`sub` claim).
  providerUserId String       @map("provider_user_id") @db.VarChar(255)
  email          String?      @db.Citext
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

/// A one-time code sent by SMS for phone sign-in. Only an HMAC of the code is stored.
model OtpChallenge {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// E.164 phone number the code was sent to.
  phone      String    @db.VarChar(16)
  codeHash   String    @map("code_hash") @db.Char(64)
  attempts   Int       @default(0) @db.SmallInt
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("otp_challenges")
}

/// Single-use links for email verification and password reset. Only the token hash is stored.
model VerificationToken {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  purpose    TokenPurpose
  tokenHash  String       @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?    @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Trips (free community trips; commercial departures link to a package)
// ─────────────────────────────────────────────────────────────────────────────

model Trip {
  id                       String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organiserId              String                                 @map("organiser_id") @db.Uuid
  communityId              String?                                @map("community_id") @db.Uuid
  /// Set only for COMMERCIAL_PAID trips (enforced by a CHECK constraint).
  commercialPackageId      String?                                @map("commercial_package_id") @db.Uuid
  mode                     TripMode
  activityType             ActivityType                           @map("activity_type")
  tripType                 TripType                               @default(COMMUNITY_FREE) @map("trip_type")
  visibility               TripVisibility                         @default(PUBLIC)
  status                   TripStatus                             @default(DRAFT)
  title                    String                                 @db.VarChar(120)
  description              String?                                @db.VarChar(5000)
  originName               String                                 @map("origin_name") @db.VarChar(160)
  /// Exact meeting point; only shown to approved participants. Nullable while DRAFT.
  origin                   Unsupported("geography(Point, 4326)")?
  destinationName          String                                 @map("destination_name") @db.VarChar(160)
  destination              Unsupported("geography(Point, 4326)")?
  departureAt              DateTime                               @map("departure_at") @db.Timestamptz(3)
  returnAt                 DateTime?                              @map("return_at") @db.Timestamptz(3)
  minParticipants          Int                                    @default(1) @map("min_participants") @db.SmallInt
  maxParticipants          Int                                    @map("max_participants") @db.SmallInt
  /// Per-person cost-sharing estimate for community trips. Not a price; nothing is charged.
  estimatedBudgetPaise     Int?                                   @map("estimated_budget_paise")
  currency                 String                                 @default("INR") @db.Char(3)
  /// Organiser's estimate, not a routing result. Labelled as such in the API and apps.
  estimatedDistanceKm      Int?                                   @map("estimated_distance_km")
  /// Organiser's estimate in minutes, not a routing result.
  estimatedDurationMinutes Int?                                   @map("estimated_duration_minutes")
  minEngineCc              Int?                                   @map("min_engine_cc") @db.SmallInt
  /// Rides only: bike types the ride suits. Empty means any bike is welcome.
  bikeCategories           MotorcycleCategory[]                   @default([]) @map("bike_categories")
  difficulty               TripDifficulty?
  approvalRequired         Boolean                                @default(true) @map("approval_required")
  /// Road route computed by Google Routes (planning data, never live location).
  routeDistanceMeters      Int?                                   @map("route_distance_meters")
  routeDurationSeconds     Int?                                   @map("route_duration_seconds")
  /// TWO_WHEELER for rides, DRIVE for travel.
  routeTravelMode          String?                                @map("route_travel_mode") @db.VarChar(20)
  routeComputedAt          DateTime?                              @map("route_computed_at") @db.Timestamptz(3)
  /// Cloudinary public id, e.g. voyago-prod/trip-covers/<user>/<uuid>. Not a URL.
  coverImageKey            String?                                @map("cover_image_key")
  publishedAt              DateTime?                              @map("published_at") @db.Timestamptz(3)
  startedAt                DateTime?                              @map("started_at") @db.Timestamptz(3)
  completedAt              DateTime?                              @map("completed_at") @db.Timestamptz(3)
  /// Set when the "trip tomorrow" reminder went out, so it is sent once.
  reminderSentAt           DateTime?                              @map("reminder_sent_at") @db.Timestamptz(3)
  cancelledAt              DateTime?                              @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason       String?                                @map("cancellation_reason") @db.VarChar(500)
  /// Hidden by moderators: only the organiser, participants and staff can still see it.
  hiddenAt                 DateTime?                              @map("hidden_at") @db.Timestamptz(3)
  hiddenReason             String?                                @map("hidden_reason") @db.VarChar(500)
  hiddenById               String?                                @map("hidden_by_id") @db.Uuid
  createdAt                DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                DateTime?                              @map("deleted_at") @db.Timestamptz(3)
  /// Generated by Postgres from title, places and description (see migration); never written.
  searchVector             Unsupported("tsvector")?               @default(dbgenerated()) @map("search_vector")

  organiser         User               @relation("TripOrganiser", fields: [organiserId], references: [id], onDelete: Restrict)
  hiddenBy          User?              @relation("TripHider", fields: [hiddenById], references: [id], onDelete: SetNull)
  community         Community?         @relation(fields: [communityId], references: [id], onDelete: SetNull)
  commercialPackage CommercialPackage? @relation(fields: [commercialPackageId], references: [id], onDelete: Restrict)
  stops             TripStop[]
  participants      TripParticipant[]
  joinRequests      TripJoinRequest[]
  invitations       TripInvitation[]
  posts             Post[]
  conversation      Conversation?
  reviews           Review[]
  bookings          Booking[]
  locationSessions  LocationSession[]
  checkIns          TripCheckIn[]
  sosAlerts         SosAlert[]

  @@index([status, departureAt])
  @@index([mode, status, departureAt])
  @@index([organiserId])
  @@index([communityId])
  @@index([commercialPackageId])
  @@index([origin], type: Gist)
  @@index([destination], type: Gist)
  @@index([searchVector], map: "trips_search_idx", type: Gin)
  @@map("trips")
}

model TripStop {
  id               String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId           String                                @map("trip_id") @db.Uuid
  /// 1-based order along the route.
  position         Int                                   @db.SmallInt
  name             String                                @db.VarChar(160)
  location         Unsupported("geography(Point, 4326)")
  plannedArrivalAt DateTime?                             @map("planned_arrival_at") @db.Timestamptz(3)
  notes            String?                               @db.VarChar(500)
  createdAt        DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, position])
  @@index([location], type: Gist)
  @@map("trip_stops")
}

model TripParticipant {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId        String            @map("trip_id") @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  role          ParticipantRole   @default(PARTICIPANT)
  status        ParticipantStatus @default(ACTIVE)
  joinedAt      DateTime          @default(now()) @map("joined_at") @db.Timestamptz(3)
  /// When the member left or was removed.
  leftAt        DateTime?         @map("left_at") @db.Timestamptz(3)
  removedById   String?           @map("removed_by_id") @db.Uuid
  removalReason String?           @map("removal_reason") @db.VarChar(500)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip      Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User  @relation("Participant", fields: [userId], references: [id], onDelete: Cascade)
  removedBy User? @relation("ParticipantRemover", fields: [removedById], references: [id], onDelete: SetNull)

  @@unique([tripId, userId])
  @@index([userId, status])
  @@map("trip_participants")
}

/// One row per (trip, user). A user re-requesting after a rejection updates the same row.
model TripJoinRequest {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId          String            @map("trip_id") @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  status          JoinRequestStatus @default(PENDING)
  message         String?           @db.VarChar(500)
  decidedById     String?           @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?         @map("decided_at") @db.Timestamptz(3)
  rejectionReason String?           @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip      Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User  @relation("JoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("JoinRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  // At most one PENDING request per member and trip: partial unique index in the migration.
  @@index([tripId, status])
  @@index([userId, status])
  @@map("trip_join_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// Communities and social graph
// ─────────────────────────────────────────────────────────────────────────────

model Community {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String              @unique @db.Citext
  name          String              @db.VarChar(100)
  description   String?             @db.VarChar(2000)
  /// Null means the community covers both Ride and Travel.
  mode          TripMode?
  visibility    CommunityVisibility @default(PUBLIC)
  joinPolicy    CommunityJoinPolicy @default(OPEN) @map("join_policy")
  category      CommunityCategory   @default(OTHER)
  city          String?             @db.VarChar(80)
  coverImageKey String?             @map("cover_image_key")
  createdById   String              @map("created_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?           @map("deleted_at") @db.Timestamptz(3)

  createdBy    User              @relation("CommunityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members      CommunityMember[]
  trips        Trip[]
  posts        Post[]
  conversation Conversation?

  @@index([city])
  @@index([mode])
  @@map("communities")
}

model CommunityMember {
  communityId String           @map("community_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  role        CommunityRole    @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  /// Note sent with a request to join.
  message     String?          @db.VarChar(500)
  joinedAt    DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@index([userId])
  @@index([communityId, status])
  @@map("community_members")
}

model Follow {
  followerId String   @map("follower_id") @db.Uuid
  followeeId String   @map("followee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId])
  @@map("follows")
}

/// An invitation to a trip, needed to join PRIVATE trips. Sent by the organiser or a co-organiser.
model TripInvitation {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId      String               @map("trip_id") @db.Uuid
  inviteeId   String               @map("invitee_id") @db.Uuid
  invitedById String?              @map("invited_by_id") @db.Uuid
  status      TripInvitationStatus @default(PENDING)
  respondedAt DateTime?            @map("responded_at") @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip      Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  invitee   User  @relation("TripInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("TripInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  // At most one PENDING invitation per person and trip: partial unique index in the migration.
  @@index([tripId, status])
  @@index([inviteeId, status])
  @@map("trip_invitations")
}

/// Feed posts: trip recaps, destination photos and community announcements.
model Post {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId    String         @map("author_id") @db.Uuid
  type        PostType
  visibility  PostVisibility @default(PUBLIC)
  communityId String?        @map("community_id") @db.Uuid
  tripId      String?        @map("trip_id") @db.Uuid
  body        String?        @db.VarChar(2000)
  /// Cloudinary public ids (post-photos folder), at most 6.
  imageKeys   String[]       @default([]) @map("image_keys")
  /// Place shown with photos, e.g. "Kudremukh". A name, never coordinates.
  placeName   String?        @map("place_name") @db.VarChar(160)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(3)

  author    User       @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  trip      Trip?      @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([authorId, createdAt(sort: Desc)])
  @@index([communityId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("posts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Messaging and notifications
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          ConversationType
  tripId        String?          @unique @map("trip_id") @db.Uuid
  communityId   String?          @unique @map("community_id") @db.Uuid
  /// For DIRECT chats: the two user ids sorted and joined, so a pair has one conversation.
  directKey     String?          @unique @map("direct_key") @db.VarChar(73)
  lastMessageAt DateTime?        @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip      Trip?                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  community Community?           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members   ConversationMember[]
  messages  Message[]

  @@map("conversations")
}

model ConversationMember {
  conversationId String           @map("conversation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           ConversationRole @default(MEMBER)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt         DateTime?        @map("left_at") @db.Timestamptz(3)
  lastReadAt     DateTime?        @map("last_read_at") @db.Timestamptz(3)
  mutedUntil     DateTime?        @map("muted_until") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  /// Null for SYSTEM messages and after the sender's account is erased.
  senderId       String?     @map("sender_id") @db.Uuid
  type           MessageType @default(TEXT)
  body           String?     @db.VarChar(4000)
  attachmentKey  String?     @map("attachment_key")
  /// Id the sending device chose, so a resent message (after a dropped connection) is stored once.
  clientId       String?     @map("client_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt       DateTime?   @map("edited_at") @db.Timestamptz(3)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@unique([conversationId, senderId, clientId])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

model Notification {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  type          NotificationType
  title         String           @db.VarChar(160)
  body          String?          @db.VarChar(1000)
  /// Small routing payload (ids only, no personal data).
  data          Json?
  readAt        DateTime?        @map("read_at") @db.Timestamptz(3)
  /// Set while a push for this notification is waiting to be sent (an outbox, so a push goes out
  /// only once the change it describes is committed). Cleared when sent or skipped.
  pushPendingAt DateTime?        @map("push_pending_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

/// A device that receives push notifications (an Expo push token, delivered through FCM or APNs).
model PushToken {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  token      String       @unique @db.VarChar(255)
  platform   PushPlatform
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Trust and safety
// ─────────────────────────────────────────────────────────────────────────────

/// A participant's review of another participant (usually the organiser) after a trip.
model Review {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId     String   @map("trip_id") @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  revieweeId String   @map("reviewee_id") @db.Uuid
  /// 1 to 5 (CHECK constraint).
  rating     Int      @db.SmallInt
  comment    String?  @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip     Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  reviewer User @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([tripId, reviewerId, revieweeId])
  @@index([revieweeId, createdAt(sort: Desc)])
  @@map("reviews")
}

model Report {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Kept when the reporter's account is erased so the moderation record survives.
  reporterId     String?          @map("reporter_id") @db.Uuid
  targetType     ReportTargetType @map("target_type")
  /// Id of the reported row in the table named by target_type (polymorphic, no FK).
  targetId       String           @map("target_id") @db.Uuid
  /// The user responsible for the reported content, for fast per-user lookups.
  reportedUserId String?          @map("reported_user_id") @db.Uuid
  reason         ReportReason
  details        String?          @db.VarChar(2000)
  status         ReportStatus     @default(OPEN)
  severity       ReportSeverity   @default(MEDIUM)
  /// Moderator-added references (links, message ids, ticket numbers); at most 20.
  evidenceRefs   String[]         @default([]) @map("evidence_refs")
  assignedToId   String?          @map("assigned_to_id") @db.Uuid
  resolutionNote String?          @map("resolution_note") @db.VarChar(2000)
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  reporter     User? @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  assignedTo   User? @relation("ReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reportedUserId])
  @@map("reports")
}

/// Live location sharing session. Opt-in and time-limited (max 24 hours, CHECK constraint).
/// Coordinates are NOT stored here: pings live in Redis with a TTL and expire automatically.
model LocationSession {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String                @map("trip_id") @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  status    LocationSessionStatus @default(ACTIVE)
  startedAt DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  expiresAt DateTime              @map("expires_at") @db.Timestamptz(3)
  endedAt   DateTime?             @map("ended_at") @db.Timestamptz(3)
  /// Why sharing ended: stopped, trip_ended, left_trip, replaced, suspended.
  endReason String?               @map("end_reason") @db.VarChar(20)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId, status])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("location_sessions")
}

/// People a member wants told if they raise an SOS. Private to the member; texted only on SOS.
model EmergencyContact {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String   @db.VarChar(80)
  /// E.164. Never shown to anyone but the member.
  phone        String   @db.VarChar(16)
  relationship String?  @db.VarChar(40)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@map("emergency_contacts")
}

/// "I'm at the start", "All good", "Arrived safely". No coordinates are stored.
model TripCheckIn {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String      @map("trip_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  kind      CheckInKind
  note      String?     @db.VarChar(200)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt(sort: Desc)])
  @@map("trip_check_ins")
}

/// An SOS raised on a trip. The location is kept only while the alert is active.
model SosAlert {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId             String    @map("trip_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  status             SosStatus @default(ACTIVE)
  message            String?   @db.VarChar(300)
  latitude           Float?
  longitude          Float?
  locationRecordedAt DateTime? @map("location_recorded_at") @db.Timestamptz(3)
  membersNotified    Int       @default(0) @map("members_notified")
  contactsTexted     Int       @default(0) @map("contacts_texted")
  resolvedAt         DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedById       String?   @map("resolved_by_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  trip       Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user       User  @relation("SosRaiser", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("SosResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("sos_alerts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Commercial (kept separate from community trips)
// ─────────────────────────────────────────────────────────────────────────────

/// A business that may sell packages once VERIFIED. Separate from community organisers.
model CommercialOperator {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId        String                     @unique @map("owner_user_id") @db.Uuid
  slug               String                     @unique @db.Citext
  legalName          String                     @map("legal_name") @db.VarChar(200)
  displayName        String                     @map("display_name") @db.VarChar(120)
  /// Indian GST identification number (15 characters), when registered.
  gstin              String?                    @unique @db.Char(15)
  /// Business contact details (not the owner's personal contact).
  businessEmail      String?                    @map("business_email") @db.Citext
  businessPhone      String?                    @map("business_phone") @db.VarChar(16)
  category           OperatorCategory
  description        String?                    @db.VarChar(2000)
  website            String?                    @db.VarChar(200)
  addressLine1       String?                    @map("address_line1") @db.VarChar(200)
  addressLine2       String?                    @map("address_line2") @db.VarChar(200)
  city               String?                    @db.VarChar(80)
  state              String?                    @db.VarChar(80)
  postalCode         String?                    @map("postal_code") @db.VarChar(10)
  country            String                     @default("IN") @db.Char(2)
  /// When the owner accepted the operator terms, and which version.
  termsAcceptedAt    DateTime?                  @map("terms_accepted_at") @db.Timestamptz(3)
  termsVersion       String?                    @map("terms_version") @db.VarChar(20)
  verificationStatus OperatorVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?                  @map("verified_at") @db.Timestamptz(3)
  verifiedById       String?                    @map("verified_by_id") @db.Uuid
  /// Latest reason given by staff for the verification status.
  verificationNote   String?                    @map("verification_note") @db.VarChar(1000)
  /// When the operator submitted documents for review.
  submittedAt        DateTime?                  @map("submitted_at") @db.Timestamptz(3)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner      User                @relation("OperatorOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  verifiedBy User?               @relation("OperatorVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  packages   CommercialPackage[]
  documents  OperatorDocument[]
  ledger     LedgerEntry[]

  @@index([verificationStatus])
  @@map("commercial_operators")
}

/// Business documentation an operator submits for verification. Sensitive: the file is a private
/// Cloudinary asset, opened only through short-lived links by staff allowed to (each view audited).
model OperatorDocument {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operatorId   String                 @map("operator_id") @db.Uuid
  kind         OperatorDocumentKind
  /// Private Cloudinary public id (operator-docs folder). Not a URL.
  storageKey   String                 @map("storage_key")
  /// File extension used for downloads, e.g. pdf, jpg.
  format       String                 @db.VarChar(10)
  fileName     String                 @map("file_name") @db.VarChar(200)
  status       OperatorDocumentStatus @default(PENDING)
  reviewNote   String?                @map("review_note") @db.VarChar(1000)
  reviewedById String?                @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?              @map("reviewed_at") @db.Timestamptz(3)
  uploadedAt   DateTime               @default(now()) @map("uploaded_at") @db.Timestamptz(3)

  operator   CommercialOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  reviewedBy User?              @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([operatorId])
  @@map("operator_documents")
}

/// A paid travel experience. Never passenger transport or ride-hailing.
model CommercialPackage {
  id                 String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operatorId         String                                 @map("operator_id") @db.Uuid
  mode               TripMode
  activityType       ActivityType                           @map("activity_type")
  title              String                                 @db.VarChar(120)
  description        String?                                @db.VarChar(5000)
  destinationName    String                                 @map("destination_name") @db.VarChar(160)
  destination        Unsupported("geography(Point, 4326)")?
  durationDays       Int                                    @map("duration_days") @db.SmallInt
  pricePaise         Int                                    @map("price_paise")
  currency           String                                 @default("INR") @db.Char(3)
  maxGroupSize       Int                                    @map("max_group_size") @db.SmallInt
  inclusions         String[]                               @default([])
  exclusions         String[]                               @default([])
  cancellationPolicy String                                 @map("cancellation_policy") @db.VarChar(2000)
  status             PackageStatus                          @default(DRAFT)
  coverImageKey      String?                                @map("cover_image_key")
  /// Public Cloudinary ids of the package photos, in display order (at most 8).
  imageKeys          String[]                               @default([]) @map("image_keys")
  startsAt           DateTime?                              @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime?                              @map("ends_at") @db.Timestamptz(3)
  meetingPointName   String?                                @map("meeting_point_name") @db.VarChar(160)
  meetingPoint       Unsupported("geography(Point, 4326)")? @map("meeting_point")
  /// Detail views by people other than the operator (for the operator's summary).
  viewCount          Int                                    @default(0) @map("view_count")
  /// Why staff suspended the listing (status SUSPENDED).
  suspendedReason    String?                                @map("suspended_reason") @db.VarChar(1000)
  /// Refund schedule: [{ hoursBefore, refundPercent }], most hours first. Required to publish.
  refundTiers        Json                                   @default("[]") @map("refund_tiers")
  publishedAt        DateTime?                              @map("published_at") @db.Timestamptz(3)
  createdAt          DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)

  operator  CommercialOperator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  trips     Trip[]
  bookings  Booking[]
  questions PackageQuestion[]

  @@index([operatorId])
  @@index([status, mode])
  @@index([destination], type: Gist)
  @@index([status, startsAt])
  @@map("commercial_packages")
}

/// A member's question about a package, answered by its operator. Answered questions are public.
model PackageQuestion {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId    String    @map("package_id") @db.Uuid
  askerId      String    @map("asker_id") @db.Uuid
  question     String    @db.VarChar(500)
  answer       String?   @db.VarChar(1000)
  answeredAt   DateTime? @map("answered_at") @db.Timestamptz(3)
  answeredById String?   @map("answered_by_id") @db.Uuid
  /// Hidden by the operator or staff (spam or abuse); kept for moderation.
  hiddenAt     DateTime? @map("hidden_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  package    CommercialPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  asker      User              @relation("PackageQuestionAsker", fields: [askerId], references: [id], onDelete: Cascade)
  answeredBy User?             @relation("PackageQuestionAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([packageId, createdAt(sort: Desc)])
  @@index([askerId])
  @@map("package_questions")
}

/// A purchase of a commercial package. Community trips never have bookings (trigger-enforced).
model Booking {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  packageId            String             @map("package_id") @db.Uuid
  /// The scheduled COMMERCIAL_PAID departure, when the package has fixed dates.
  tripId               String?            @map("trip_id") @db.Uuid
  status               BookingStatus      @default(PENDING_PAYMENT)
  seats                Int                @db.SmallInt
  unitPricePaise       Int                @map("unit_price_paise")
  platformFeePaise     Int                @default(0) @map("platform_fee_paise")
  totalAmountPaise     Int                @map("total_amount_paise")
  currency             String             @default("INR") @db.Char(3)
  /// Client key per checkout attempt: retries return the same booking.
  idempotencyKey       String             @map("idempotency_key") @db.VarChar(100)
  /// Places are held until then while the payment is pending.
  expiresAt            DateTime?          @map("expires_at") @db.Timestamptz(3)
  confirmedAt          DateTime?          @map("confirmed_at") @db.Timestamptz(3)
  /// Commission rate and tax rate in basis points, fixed when the booking is made.
  commissionBps        Int                @map("commission_bps")
  commissionPaise      Int                @map("commission_paise")
  commissionTaxBps     Int                @map("commission_tax_bps")
  commissionTaxPaise   Int                @map("commission_tax_paise")
  operatorPayablePaise Int                @map("operator_payable_paise")
  refundedAmountPaise  Int                @default(0) @map("refunded_amount_paise")
  /// The package's cancellation terms when booked.
  cancellationPolicy   String             @map("cancellation_policy") @db.VarChar(2000)
  refundTiers          Json               @default("[]") @map("refund_tiers")
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy          CancellationActor? @map("cancelled_by")
  cancellationReason   String?            @map("cancellation_reason") @db.VarChar(500)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  package  CommercialPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  trip     Trip?             @relation(fields: [tripId], references: [id], onDelete: Restrict)
  payments Payment[]
  refunds  Refund[]
  ledger   LedgerEntry[]
  events   PaymentEvent[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([packageId])
  @@index([tripId])
  @@index([status])
  @@index([status, expiresAt])
  @@map("bookings")
}

/// A payment attempt with an external gateway. Card data is never stored: only gateway ids.
model Payment {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  /// Exactly one of booking_id / subscription_id is set (CHECK constraint).
  bookingId           String?       @map("booking_id") @db.Uuid
  subscriptionId      String?       @map("subscription_id") @db.Uuid
  /// Gateway name, chosen in milestone 13. No gateway is integrated yet.
  provider            String        @db.VarChar(40)
  providerOrderId     String?       @map("provider_order_id") @db.VarChar(100)
  providerPaymentId   String?       @map("provider_payment_id") @db.VarChar(100)
  status              PaymentStatus @default(CREATED)
  amountPaise         Int           @map("amount_paise")
  refundedAmountPaise Int           @default(0) @map("refunded_amount_paise")
  currency            String        @default("INR") @db.Char(3)
  /// Client-supplied key so retried requests never charge twice.
  idempotencyKey      String        @unique @map("idempotency_key") @db.VarChar(100)
  failureCode         String?       @map("failure_code") @db.VarChar(100)
  failureReason       String?       @map("failure_reason") @db.VarChar(500)
  /// The provider's fee and the tax on it, when the provider reports them.
  providerFeePaise    Int?          @map("provider_fee_paise")
  providerTaxPaise    Int?          @map("provider_tax_paise")
  /// Payment method family (card, upi, netbanking, wallet). Never card numbers.
  method              String?       @db.VarChar(30)
  capturedAt          DateTime?     @map("captured_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking      Booking?      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  refunds      Refund[]
  ledger       LedgerEntry[]

  @@unique([provider, providerPaymentId])
  @@unique([provider, providerOrderId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([bookingId])
  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

model SubscriptionPlan {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable identifier, e.g. EXPLORER_PRO_MONTHLY.
  code                   String           @unique @db.VarChar(60)
  name                   String           @db.VarChar(80)
  description            String?          @db.VarChar(1000)
  pricePaise             Int              @map("price_paise")
  currency               String           @default("INR") @db.Char(3)
  billingInterval        BillingInterval  @map("billing_interval")
  /// Which entitlements the plan grants (the list itself lives in code, per tier).
  tier                   SubscriptionTier
  /// Legacy feature notes; entitlements come from the tier.
  features               Json             @default("{}")
  isActive               Boolean          @default(true) @map("is_active")
  /// The provider's plan for the current price; a new one is made when the price changes.
  providerPlanId         String?          @map("provider_plan_id") @db.VarChar(100)
  providerPlanPricePaise Int?             @map("provider_plan_price_paise")
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String             @map("user_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus @default(PENDING)
  /// Set once paid; the paid features work until the end (see RENEWAL_GRACE_HOURS).
  currentPeriodStart     DateTime?          @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt            DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason     String?            @map("cancellation_reason") @db.VarChar(500)
  endedAt                DateTime?          @map("ended_at") @db.Timestamptz(3)
  /// The price agreed when subscribing; plan price changes never touch it.
  pricePaise             Int                @map("price_paise")
  currency               String             @default("INR") @db.Char(3)
  /// Client key per subscribe attempt: retries return the same subscription.
  idempotencyKey         String             @map("idempotency_key") @db.VarChar(100)
  /// The period end we last sent a renewal reminder for.
  remindedForPeriodEnd   DateTime?          @map("reminded_for_period_end") @db.Timestamptz(3)
  provider               String?            @db.VarChar(40)
  providerSubscriptionId String?            @map("provider_subscription_id") @db.VarChar(100)
  /// The provider's own status word, for support.
  providerStatus         String?            @map("provider_status") @db.VarChar(30)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]
  events   PaymentEvent[]

  @@unique([provider, providerSubscriptionId])
  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────────────────────

/// Append-only record of privileged and financially significant actions.
/// UPDATE and DELETE are blocked by a trigger.
model AuditLog {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?        @map("actor_id") @db.Uuid
  actorType  AuditActorType @map("actor_type")
  /// Dotted verb, e.g. "operator.verify", "booking.refund", "user.suspend".
  action     String         @db.VarChar(100)
  entityType String         @map("entity_type") @db.VarChar(60)
  entityId   String?        @map("entity_id") @db.Uuid
  /// Before/after values and reasons. No secrets or card data.
  metadata   Json?
  requestId  String?        @map("request_id") @db.VarChar(64)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// A refund of (part of) a captured payment. Every state change is also in the ledger or audit log.
model Refund {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId        String            @map("booking_id") @db.Uuid
  paymentId        String            @map("payment_id") @db.Uuid
  amountPaise      Int               @map("amount_paise")
  currency         String            @default("INR") @db.Char(3)
  status           RefundStatus      @default(PENDING)
  initiator        CancellationActor
  /// Staff member or customer who asked for it (null for automatic refunds).
  requestedById    String?           @map("requested_by_id") @db.Uuid
  reason           String?           @db.VarChar(500)
  /// The schedule step applied, for policy refunds.
  hoursBefore      Int?              @map("hours_before")
  refundPercent    Int?              @map("refund_percent") @db.SmallInt
  provider         String            @db.VarChar(40)
  providerRefundId String?           @map("provider_refund_id") @db.VarChar(100)
  idempotencyKey   String            @unique @map("idempotency_key") @db.VarChar(100)
  failureReason    String?           @map("failure_reason") @db.VarChar(500)
  processedAt      DateTime?         @map("processed_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment     Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy User?         @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  ledger      LedgerEntry[]

  @@unique([provider, providerRefundId])
  @@index([bookingId])
  @@index([status])
  @@map("refunds")
}

/// Append-only money lines per booking (amounts in paise; reversals are negative).
model LedgerEntry {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String          @map("booking_id") @db.Uuid
  operatorId  String          @map("operator_id") @db.Uuid
  paymentId   String?         @map("payment_id") @db.Uuid
  refundId    String?         @map("refund_id") @db.Uuid
  kind        LedgerEntryKind
  amountPaise Int             @map("amount_paise")
  currency    String          @default("INR") @db.Char(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  booking  Booking            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  operator CommercialOperator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  payment  Payment?           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refund   Refund?            @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@unique([paymentId, kind])
  @@unique([refundId, kind])
  @@index([bookingId])
  @@index([operatorId, createdAt])
  @@map("ledger_entries")
}

/// Every provider webhook and checkout callback received, once per provider event id.
model PaymentEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider       String    @db.VarChar(40)
  eventId        String    @map("event_id") @db.VarChar(120)
  eventType      String    @map("event_type") @db.VarChar(60)
  bookingId      String?   @map("booking_id") @db.Uuid
  signatureValid Boolean   @map("signature_valid")
  /// Only ids, statuses, amounts and error codes; never card or contact details.
  summary        Json
  result         String?   @db.VarChar(300)
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)

  booking        Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  subscriptionId String?       @map("subscription_id") @db.Uuid
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([subscriptionId])
  @@index([bookingId])
  @@index([receivedAt])
  @@map("payment_events")
}

/// A discovery search a member saved (Explorer Pro), optionally with new-trip alerts.
model SavedSearch {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  name          String    @db.VarChar(60)
  /// Discovery query values as sent by the app; re-checked every time it runs.
  query         Json
  alerts        Boolean   @default(false)
  /// Trips published after this are new for alerts.
  lastAlertedAt DateTime? @map("last_alerted_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([alerts])
  @@map("saved_searches")
}

// ─────────────────────────────────────────────────────────────────────────────
// Analytics and operations (milestone 15)
// ─────────────────────────────────────────────────────────────────────────────

/// The event dictionary is in packages/shared/src/analytics.ts.
enum AnalyticsEventName {
  account_registered
  profile_completed
  trip_created
  trip_published
  trip_viewed
  join_requested
  join_approved
  trip_started
  trip_completed
  trip_cancelled
  community_joined
  booking_started
  booking_confirmed
  subscription_started
  user_active
}

/// A product event. No user id: `actorKey` is a keyed hash of it, so events can be counted per
/// person (retention, repeat organisers) without saying who. Properties are whitelisted per event.
model AnalyticsEvent {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       AnalyticsEventName
  actorKey   String?            @map("actor_key") @db.Char(32)
  properties Json               @default("{}")
  occurredAt DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([name, occurredAt])
  @@index([actorKey, occurredAt])
  @@index([occurredAt])
  @@map("analytics_events")
}

/// The last runs of each background job, for the system status page and alerts.
model JobRun {
  name                String    @id @db.VarChar(60)
  lastStartedAt       DateTime? @map("last_started_at") @db.Timestamptz(3)
  lastSuccessAt       DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastError           String?   @map("last_error") @db.VarChar(500)
  lastErrorAt         DateTime? @map("last_error_at") @db.Timestamptz(3)
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  runs                Int       @default(0)
  failures            Int       @default(0)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("job_runs")
}
