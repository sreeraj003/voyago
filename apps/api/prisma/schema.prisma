  PUBLISHED
  /// Published and at capacity; returns to PUBLISHED when a place frees up.
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
  /// Published but never started; set by the expiry job after departure has passed.
  EXPIRED
}

enum TripDifficulty {
  EASY
  MODERATE
  CHALLENGING
}

enum ParticipantRole {
  ORGANISER
  CO_ORGANISER
  PARTICIPANT
}

enum ParticipantStatus {
  ACTIVE
