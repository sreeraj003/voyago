}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum CommunityJoinPolicy {
  OPEN
  APPROVAL
}

enum CommunityRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  PENDING
  /// Left of their own accord; may join again.
  LEFT
  /// Removed by a moderator; may ask again (unless BANNED).
  REMOVED
  BANNED
}

enum CommunityCategory {
  RIDING_CLUB
  TOURING
  TREKKING
  BACKPACKING
  ROAD_TRIPS
  PHOTOGRAPHY
  OTHER
}

enum TripInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum PostType {
