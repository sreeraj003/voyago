// Voyago database schema.
//
// Conventions (see docs/DATABASE.md for the full rationale):
// - UUID primary keys generated by Postgres (gen_random_uuid()).
// - snake_case table and column names; timestamps are timestamptz (UTC).
// - Money is stored as integer minor units (paise) in *_paise columns. Never floats.
// - PostGIS geography(Point, 4326) columns are declared as Unsupported and written with raw SQL.
// - CHECK constraints and triggers that Prisma cannot express live in the migration SQL.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum TravelStyle {
  BUDGET
  COMFORT
  LUXURY
  ADVENTURE
  RELAXED
  CULTURAL
  NATURE
  SOCIAL
}

enum RidingExperience {
  BEGINNER
  INTERMEDIATE
  EXPERIENCED
  EXPERT
}

enum VehicleVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum AuthProvider {
  GOOGLE
  APPLE
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum TripMode {
  RIDE
  TRAVEL
}

enum ProfileVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum MessagePermission {
  EVERYONE
  FOLLOWERS
  TRIP_PARTICIPANTS
  NOBODY
}

enum MotorcycleCategory {
  STREET
  SPORT
  CRUISER
  TOURER
  ADVENTURE
  OFF_ROAD
  SCOOTER
  OTHER
}

enum ActivityType {
  MOTORCYCLE_RIDE
  ROAD_TRIP
  BACKPACKING
  TREK
  WEEKEND_GETAWAY
  OTHER
}

enum TripType {
  COMMUNITY_FREE
  COMMERCIAL_PAID
}

enum TripVisibility {
  PUBLIC
  FOLLOWERS
  COMMUNITY
