// Voyago database schema.
//
// Conventions (see docs/DATABASE.md for the full rationale):
// - UUID primary keys generated by Postgres (gen_random_uuid()).
// - snake_case table and column names; timestamps are timestamptz (UTC).
// - Money is stored as integer minor units (paise) in *_paise columns. Never floats.
// - PostGIS geography(Point, 4326) columns are declared as Unsupported and written with raw SQL.
// - CHECK constraints and triggers that Prisma cannot express live in the migration SQL.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum TripMode {
  RIDE
  TRAVEL
}

enum ProfileVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum MessagePermission {
  EVERYONE
  FOLLOWERS
  TRIP_PARTICIPANTS
  NOBODY
}

enum MotorcycleCategory {
  STREET
  SPORT
  CRUISER
  TOURER
  ADVENTURE
  OFF_ROAD
  SCOOTER
  OTHER
}

enum ActivityType {
  MOTORCYCLE_RIDE
  ROAD_TRIP
  BACKPACKING
  TREK
  WEEKEND_GETAWAY
  OTHER
}

enum TripType {
  COMMUNITY_FREE
  COMMERCIAL_PAID
}

enum TripVisibility {
  PUBLIC
  FOLLOWERS
  COMMUNITY
  INVITE_ONLY
}

enum TripStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TripDifficulty {
  EASY
  MODERATE
  CHALLENGING
}

enum ParticipantRole {
  ORGANISER
  CO_ORGANISER
  PARTICIPANT
}

enum ParticipantStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum CommunityJoinPolicy {
  OPEN
  APPROVAL
}

enum CommunityRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  PENDING
  BANNED
}

enum ConversationType {
  TRIP_GROUP
  COMMUNITY
  DIRECT
}

enum ConversationRole {
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum NotificationType {
  JOIN_REQUEST_RECEIVED
  JOIN_REQUEST_APPROVED
  JOIN_REQUEST_REJECTED
  TRIP_UPDATED
  TRIP_CANCELLED
  NEW_MESSAGE
  NEW_FOLLOWER
  COMMUNITY_INVITE
  SAFETY_ALERT
  BOOKING_UPDATE
  PAYMENT_UPDATE
  SYSTEM
}

enum ReportTargetType {
  USER
  TRIP
  MESSAGE
  COMMUNITY
  REVIEW
  COMMERCIAL_PACKAGE
}

enum ReportReason {
  HARASSMENT
  SPAM
  FAKE_PROFILE
  UNSAFE_BEHAVIOUR
  INAPPROPRIATE_CONTENT
  SCAM_OR_FRAUD
  ILLEGAL_TRANSPORT
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  ACTIONED
  DISMISSED
}

enum OperatorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum PackageStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
  ARCHIVED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  REFUNDED
  COMPLETED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum LocationSessionStatus {
  ACTIVE
  ENDED
  EXPIRED
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

// ─────────────────────────────────────────────────────────────────────────────
// Users and profiles
// ─────────────────────────────────────────────────────────────────────────────

/// A registered member. Contact details (email, phone) are private and never public.
model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Case-insensitive unique handle.
  username        String     @unique @db.Citext
  /// Case-insensitive unique; private.
  email           String?    @unique @db.Citext
  /// E.164 format; private.
  phone           String?    @unique @db.VarChar(16)
  /// Argon2/bcrypt hash set in milestone 04. Never the password itself.
  passwordHash    String?    @map("password_hash")
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  displayName     String     @map("display_name") @db.VarChar(80)
  bio             String?    @db.VarChar(500)
  /// Object-storage key, not a URL.
  avatarKey       String?    @map("avatar_key")
  birthDate       DateTime?  @map("birth_date") @db.Date
  /// Public, city-level only. Exact home location is never stored.
  homeCity        String?    @map("home_city") @db.VarChar(80)
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  lastActiveAt    DateTime?  @map("last_active_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Soft delete; personal fields are scrubbed by the account-deletion job.
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  preferences         UserPreference?
  motorcycles         Motorcycle[]
  organisedTrips      Trip[]               @relation("TripOrganiser")
  participations      TripParticipant[]
  joinRequests        TripJoinRequest[]    @relation("JoinRequester")
  decidedJoinRequests TripJoinRequest[]    @relation("JoinRequestDecider")
  createdCommunities  Community[]          @relation("CommunityCreator")
  communityMembership CommunityMember[]
  following           Follow[]             @relation("Follower")
  followers           Follow[]             @relation("Followee")
  blocking            UserBlock[]          @relation("Blocker")
  blockedBy           UserBlock[]          @relation("Blocked")
  conversationMembers ConversationMember[]
  sentMessages        Message[]
  notifications       Notification[]
  reviewsWritten      Review[]             @relation("Reviewer")
  reviewsReceived     Review[]             @relation("Reviewee")
  reportsFiled        Report[]             @relation("Reporter")
  reportsAgainst      Report[]             @relation("ReportedUser")
  reportsAssigned     Report[]             @relation("ReportAssignee")
  operator            CommercialOperator?  @relation("OperatorOwner")
  verifiedOperators   CommercialOperator[] @relation("OperatorVerifier")
  bookings            Booking[]
  payments            Payment[]
  subscriptions       Subscription[]
  locationSessions    LocationSession[]
  auditLogs           AuditLog[]

  @@index([status])
  @@index([homeCity])
  @@map("users")
}

model UserPreference {
  userId            String            @id @map("user_id") @db.Uuid
  preferredMode     TripMode?         @map("preferred_mode")
  /// Free-form interest tags, e.g. "photography", "camping".
  interests         String[]          @default([])
  budgetMinPaise    Int?              @map("budget_min_paise")
  budgetMaxPaise    Int?              @map("budget_max_paise")
  profileVisibility ProfileVisibility @default(PUBLIC) @map("profile_visibility")
  showAge           Boolean           @default(false) @map("show_age")
  allowMessagesFrom MessagePermission @default(TRIP_PARTICIPANTS) @map("allow_messages_from")
  pushEnabled       Boolean           @default(true) @map("push_enabled")
  emailEnabled      Boolean           @default(true) @map("email_enabled")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// Safety: a block hides each user from the other. Always free.
model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Motorcycle {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId   String             @map("owner_id") @db.Uuid
  make      String             @db.VarChar(60)
  model     String             @db.VarChar(80)
  year      Int?               @db.SmallInt
  engineCc  Int?               @map("engine_cc") @db.SmallInt
  category  MotorcycleCategory
  nickname  String?            @db.VarChar(60)
  photoKey  String?            @map("photo_key")
  isPrimary Boolean            @default(false) @map("is_primary")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("motorcycles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Trips (free community trips; commercial departures link to a package)
// ─────────────────────────────────────────────────────────────────────────────

model Trip {
  id                   String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organiserId          String                                 @map("organiser_id") @db.Uuid
  communityId          String?                                @map("community_id") @db.Uuid
  /// Set only for COMMERCIAL_PAID trips (enforced by a CHECK constraint).
  commercialPackageId  String?                                @map("commercial_package_id") @db.Uuid
  mode                 TripMode
  activityType         ActivityType                           @map("activity_type")
  tripType             TripType                               @default(COMMUNITY_FREE) @map("trip_type")
  visibility           TripVisibility                         @default(PUBLIC)
  status               TripStatus                             @default(DRAFT)
  title                String                                 @db.VarChar(120)
  description          String?                                @db.VarChar(5000)
  originName           String                                 @map("origin_name") @db.VarChar(160)
  /// Exact meeting point; only shown to approved participants. Nullable while DRAFT.
  origin               Unsupported("geography(Point, 4326)")?
  destinationName      String                                 @map("destination_name") @db.VarChar(160)
  destination          Unsupported("geography(Point, 4326)")?
  departureAt          DateTime                               @map("departure_at") @db.Timestamptz(3)
  returnAt             DateTime?                              @map("return_at") @db.Timestamptz(3)
  minParticipants      Int                                    @default(1) @map("min_participants") @db.SmallInt
  maxParticipants      Int                                    @map("max_participants") @db.SmallInt
  /// Per-person cost-sharing estimate for community trips. Not a price; nothing is charged.
  estimatedBudgetPaise Int?                                   @map("estimated_budget_paise")
  currency             String                                 @default("INR") @db.Char(3)
  estimatedDistanceKm  Int?                                   @map("estimated_distance_km")
  minEngineCc          Int?                                   @map("min_engine_cc") @db.SmallInt
  difficulty           TripDifficulty?
  approvalRequired     Boolean                                @default(true) @map("approval_required")
  coverImageKey        String?                                @map("cover_image_key")
  publishedAt          DateTime?                              @map("published_at") @db.Timestamptz(3)
  cancelledAt          DateTime?                              @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason   String?                                @map("cancellation_reason") @db.VarChar(500)
  createdAt            DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?                              @map("deleted_at") @db.Timestamptz(3)

  organiser         User               @relation("TripOrganiser", fields: [organiserId], references: [id], onDelete: Restrict)
  community         Community?         @relation(fields: [communityId], references: [id], onDelete: SetNull)
  commercialPackage CommercialPackage? @relation(fields: [commercialPackageId], references: [id], onDelete: Restrict)
  stops             TripStop[]
  participants      TripParticipant[]
  joinRequests      TripJoinRequest[]
  conversation      Conversation?
  reviews           Review[]
  bookings          Booking[]
  locationSessions  LocationSession[]

  @@index([status, departureAt])
  @@index([mode, status, departureAt])
  @@index([organiserId])
  @@index([communityId])
  @@index([commercialPackageId])
  @@index([origin], type: Gist)
  @@index([destination], type: Gist)
  @@map("trips")
}

model TripStop {
  id               String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId           String                                @map("trip_id") @db.Uuid
  /// 1-based order along the route.
  position         Int                                   @db.SmallInt
  name             String                                @db.VarChar(160)
  location         Unsupported("geography(Point, 4326)")
  plannedArrivalAt DateTime?                             @map("planned_arrival_at") @db.Timestamptz(3)
  notes            String?                               @db.VarChar(500)
  createdAt        DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, position])
  @@index([location], type: Gist)
  @@map("trip_stops")
}

model TripParticipant {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String            @map("trip_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  role      ParticipantRole   @default(PARTICIPANT)
  status    ParticipantStatus @default(ACTIVE)
  joinedAt  DateTime          @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt    DateTime?         @map("left_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId, status])
  @@map("trip_participants")
}

/// One row per (trip, user). A user re-requesting after a rejection updates the same row.
model TripJoinRequest {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId          String            @map("trip_id") @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  status          JoinRequestStatus @default(PENDING)
  message         String?           @db.VarChar(500)
  decidedById     String?           @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?         @map("decided_at") @db.Timestamptz(3)
  rejectionReason String?           @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip      Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User  @relation("JoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("JoinRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([tripId, userId])
  @@index([tripId, status])
  @@index([userId, status])
  @@map("trip_join_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// Communities and social graph
// ─────────────────────────────────────────────────────────────────────────────

model Community {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String              @unique @db.Citext
  name          String              @db.VarChar(100)
  description   String?             @db.VarChar(2000)
  /// Null means the community covers both Ride and Travel.
  mode          TripMode?
  visibility    CommunityVisibility @default(PUBLIC)
  joinPolicy    CommunityJoinPolicy @default(OPEN) @map("join_policy")
  city          String?             @db.VarChar(80)
  coverImageKey String?             @map("cover_image_key")
  createdById   String              @map("created_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?           @map("deleted_at") @db.Timestamptz(3)

  createdBy    User              @relation("CommunityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members      CommunityMember[]
  trips        Trip[]
  conversation Conversation?

  @@index([city])
  @@index([mode])
  @@map("communities")
}

model CommunityMember {
  communityId String           @map("community_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  role        CommunityRole    @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@index([userId])
  @@map("community_members")
}

model Follow {
  followerId String   @map("follower_id") @db.Uuid
  followeeId String   @map("followee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId])
  @@map("follows")
}

// ─────────────────────────────────────────────────────────────────────────────
// Messaging and notifications
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          ConversationType
  tripId        String?          @unique @map("trip_id") @db.Uuid
  communityId   String?          @unique @map("community_id") @db.Uuid
  /// For DIRECT chats: the two user ids sorted and joined, so a pair has one conversation.
  directKey     String?          @unique @map("direct_key") @db.VarChar(73)
  lastMessageAt DateTime?        @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip      Trip?                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  community Community?           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members   ConversationMember[]
  messages  Message[]

  @@map("conversations")
}

model ConversationMember {
  conversationId String           @map("conversation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           ConversationRole @default(MEMBER)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt         DateTime?        @map("left_at") @db.Timestamptz(3)
  lastReadAt     DateTime?        @map("last_read_at") @db.Timestamptz(3)
  mutedUntil     DateTime?        @map("muted_until") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  /// Null for SYSTEM messages and after the sender's account is erased.
  senderId       String?     @map("sender_id") @db.Uuid
  type           MessageType @default(TEXT)
  body           String?     @db.VarChar(4000)
  attachmentKey  String?     @map("attachment_key")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt       DateTime?   @map("edited_at") @db.Timestamptz(3)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(160)
  body      String?          @db.VarChar(1000)
  /// Small routing payload (ids only, no personal data).
  data      Json?
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Trust and safety
// ─────────────────────────────────────────────────────────────────────────────

/// A participant's review of another participant (usually the organiser) after a trip.
model Review {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId     String   @map("trip_id") @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  revieweeId String   @map("reviewee_id") @db.Uuid
  /// 1 to 5 (CHECK constraint).
  rating     Int      @db.SmallInt
  comment    String?  @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip     Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  reviewer User @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([tripId, reviewerId, revieweeId])
  @@index([revieweeId, createdAt(sort: Desc)])
  @@map("reviews")
}

model Report {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Kept when the reporter's account is erased so the moderation record survives.
  reporterId     String?          @map("reporter_id") @db.Uuid
  targetType     ReportTargetType @map("target_type")
  /// Id of the reported row in the table named by target_type (polymorphic, no FK).
  targetId       String           @map("target_id") @db.Uuid
  /// The user responsible for the reported content, for fast per-user lookups.
  reportedUserId String?          @map("reported_user_id") @db.Uuid
  reason         ReportReason
  details        String?          @db.VarChar(2000)
  status         ReportStatus     @default(OPEN)
  assignedToId   String?          @map("assigned_to_id") @db.Uuid
  resolutionNote String?          @map("resolution_note") @db.VarChar(2000)
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  reporter     User? @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  assignedTo   User? @relation("ReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reportedUserId])
  @@map("reports")
}

/// Live location sharing session. Opt-in and time-limited (max 24 hours, CHECK constraint).
/// Coordinates are NOT stored here: pings live in Redis with a TTL and expire automatically.
model LocationSession {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String                @map("trip_id") @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  status    LocationSessionStatus @default(ACTIVE)
  startedAt DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  expiresAt DateTime              @map("expires_at") @db.Timestamptz(3)
  endedAt   DateTime?             @map("ended_at") @db.Timestamptz(3)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId, status])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("location_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Commercial (kept separate from community trips)
// ─────────────────────────────────────────────────────────────────────────────

/// A business that may sell packages once VERIFIED. Separate from community organisers.
model CommercialOperator {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId        String                     @unique @map("owner_user_id") @db.Uuid
  slug               String                     @unique @db.Citext
  legalName          String                     @map("legal_name") @db.VarChar(200)
  displayName        String                     @map("display_name") @db.VarChar(120)
  /// Indian GST identification number (15 characters), when registered.
  gstin              String?                    @unique @db.Char(15)
  /// Business contact details (not the owner's personal contact).
  businessEmail      String?                    @map("business_email") @db.Citext
  businessPhone      String?                    @map("business_phone") @db.VarChar(16)
  verificationStatus OperatorVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?                  @map("verified_at") @db.Timestamptz(3)
  verifiedById       String?                    @map("verified_by_id") @db.Uuid
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner      User                @relation("OperatorOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  verifiedBy User?               @relation("OperatorVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  packages   CommercialPackage[]

  @@index([verificationStatus])
  @@map("commercial_operators")
}

/// A paid travel experience. Never passenger transport or ride-hailing.
model CommercialPackage {
  id                 String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operatorId         String                                 @map("operator_id") @db.Uuid
  mode               TripMode
  activityType       ActivityType                           @map("activity_type")
  title              String                                 @db.VarChar(120)
  description        String?                                @db.VarChar(5000)
  destinationName    String                                 @map("destination_name") @db.VarChar(160)
  destination        Unsupported("geography(Point, 4326)")?
  durationDays       Int                                    @map("duration_days") @db.SmallInt
  pricePaise         Int                                    @map("price_paise")
  currency           String                                 @default("INR") @db.Char(3)
  maxGroupSize       Int                                    @map("max_group_size") @db.SmallInt
  inclusions         String[]                               @default([])
  exclusions         String[]                               @default([])
  cancellationPolicy String                                 @map("cancellation_policy") @db.VarChar(2000)
  status             PackageStatus                          @default(DRAFT)
  coverImageKey      String?                                @map("cover_image_key")
  publishedAt        DateTime?                              @map("published_at") @db.Timestamptz(3)
  createdAt          DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)

  operator CommercialOperator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  trips    Trip[]
  bookings Booking[]

  @@index([operatorId])
  @@index([status, mode])
  @@index([destination], type: Gist)
  @@map("commercial_packages")
}

/// A purchase of a commercial package. Community trips never have bookings (trigger-enforced).
model Booking {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String        @map("user_id") @db.Uuid
  packageId          String        @map("package_id") @db.Uuid
  /// The scheduled COMMERCIAL_PAID departure, when the package has fixed dates.
  tripId             String?       @map("trip_id") @db.Uuid
  status             BookingStatus @default(PENDING_PAYMENT)
  seats              Int           @db.SmallInt
  unitPricePaise     Int           @map("unit_price_paise")
  platformFeePaise   Int           @default(0) @map("platform_fee_paise")
  totalAmountPaise   Int           @map("total_amount_paise")
  currency           String        @default("INR") @db.Char(3)
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?       @map("cancellation_reason") @db.VarChar(500)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  package  CommercialPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  trip     Trip?             @relation(fields: [tripId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([packageId])
  @@index([tripId])
  @@index([status])
  @@map("bookings")
}

/// A payment attempt with an external gateway. Card data is never stored: only gateway ids.
model Payment {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  /// Exactly one of booking_id / subscription_id is set (CHECK constraint).
  bookingId           String?       @map("booking_id") @db.Uuid
  subscriptionId      String?       @map("subscription_id") @db.Uuid
  /// Gateway name, chosen in milestone 13. No gateway is integrated yet.
  provider            String        @db.VarChar(40)
  providerOrderId     String?       @map("provider_order_id") @db.VarChar(100)
  providerPaymentId   String?       @map("provider_payment_id") @db.VarChar(100)
  status              PaymentStatus @default(CREATED)
  amountPaise         Int           @map("amount_paise")
  refundedAmountPaise Int           @default(0) @map("refunded_amount_paise")
  currency            String        @default("INR") @db.Char(3)
  /// Client-supplied key so retried requests never charge twice.
  idempotencyKey      String        @unique @map("idempotency_key") @db.VarChar(100)
  failureCode         String?       @map("failure_code") @db.VarChar(100)
  failureReason       String?       @map("failure_reason") @db.VarChar(500)
  capturedAt          DateTime?     @map("captured_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking      Booking?      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([provider, providerPaymentId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([bookingId])
  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

model SubscriptionPlan {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stable identifier, e.g. EXPLORER_PRO_MONTHLY.
  code            String          @unique @db.VarChar(60)
  name            String          @db.VarChar(80)
  description     String?         @db.VarChar(1000)
  pricePaise      Int             @map("price_paise")
  currency        String          @default("INR") @db.Char(3)
  billingInterval BillingInterval @map("billing_interval")
  /// Feature flags unlocked by the plan. Safety features are never gated.
  features        Json            @default("{}")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String             @map("user_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodStart     DateTime           @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd       DateTime           @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt            DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  provider               String?            @db.VarChar(40)
  providerSubscriptionId String?            @map("provider_subscription_id") @db.VarChar(100)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@unique([provider, providerSubscriptionId])
  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────────────────────

/// Append-only record of privileged and financially significant actions.
/// UPDATE and DELETE are blocked by a trigger.
model AuditLog {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?        @map("actor_id") @db.Uuid
  actorType  AuditActorType @map("actor_type")
  /// Dotted verb, e.g. "operator.verify", "booking.refund", "user.suspend".
  action     String         @db.VarChar(100)
  entityType String         @map("entity_type") @db.VarChar(60)
  entityId   String?        @map("entity_id") @db.Uuid
  /// Before/after values and reasons. No secrets or card data.
  metadata   Json?
  requestId  String?        @map("request_id") @db.VarChar(64)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}
