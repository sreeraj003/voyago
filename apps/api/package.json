{
  "name": "@voyago/api",
  "version": "0.1.0",
  "private": true,
  "description": "Voyago backend: NestJS modular monolith",
  "type": "module",
  "scripts": {
    "build": "pnpm prisma:generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "pnpm prisma:generate && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm prisma:generate && eslint src test prisma scripts",
    "test": "pnpm prisma:generate && vitest run",
    "test:e2e": "pnpm prisma:generate && vitest run --config ./vitest.config.e2e.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:reset": "node scripts/assert-dev-database.mjs && prisma migrate reset --force && prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/throttler": "6.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@voyago/shared": "workspace:*",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.3.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.10",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
